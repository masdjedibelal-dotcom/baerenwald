NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: POST /api/lead nur mit Header Authorization: Bearer <gleicher Wert>
# (externe Webseiten; Funnel auf derselben App nutzt die Server Action ohne Bearer)
LEAD_API_SECRET=

# Bärenwald Funnel — E-Mail (Resend)
RESEND_API_KEY=
# Absender: verifizierte Domain in Resend, z. B. "Bärenwald <leads@deinedomain.de>"
RESEND_FROM=
# Optional: separate Absender für /api/lead (Kunde / System)
RESEND_FROM_CUSTOMER=
RESEND_FROM_SYSTEM=
# Interne Benachrichtigung bei neuem Lead (Supabase + Resend)
INTERN_EMAIL=
# Optional: nur Partner-Internmails (sonst INTERN_EMAIL)
# PARTNER_INTERN_EMAIL=
# CRM Dashboard URL für Org-Portal-Benachrichtigungen (POST /api/internal/org-portal-notify)
# Auch Fallback für Partner-Annahme, wenn NEXT_PUBLIC_DASHBOARD_URL fehlt.
CRM_DASHBOARD_URL=
# CRM → POST /api/internal/partner-notify-anfrage (Bearer)
# Ohne Secret: Partner-Annahme/Ablehnung speichert trotzdem lokal (shared DB).
PARTNER_INTERNAL_API_SECRET=
# Optional: eigener Bearer für GPT-Viz Internal APIs (sonst PARTNER_INTERNAL_API_SECRET)
GPT_VIZ_INTERNAL_API_SECRET=

# Link „Dashboard öffnen“ in interner Lead-Mail
NEXT_PUBLIC_DASHBOARD_URL=

# Akzentfarbe (Tailwind funnel-accent / CSS --acc)
NEXT_PUBLIC_ACCENT_COLOR=#2E7D52

# Kanonische URL (Open Graph, Schema.org, metadataBase)
NEXT_PUBLIC_SITE_URL=https://baerenwaldmuenchen.de

# PostHog (Analytics, EU) — Token + Host müssen NEXT_PUBLIC_ sein (Client)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional: Session Replay / Toolbar UI (EU)
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
# Legacy: nur noch Fallback, wenn PROJECT_TOKEN nicht gesetzt
# NEXT_PUBLIC_POSTHOG_KEY=

# KI-Rechner (Claude) — nur Server, nicht im Frontend (Netlify: Scope „All“, nach Deploy neu bauen)
# WICHTIG: exakt CLAUDE_API_KEY (nicht claude_API_KEY — Linux ist case-sensitiv)
# Auf Netlify: echten Anthropic-Key als Secret setzen — NIEMALS einen echten Key in diese Datei committen.
# (nicht Netlify AI Gateway — ANTHROPIC_BASE_URL von Netlify wird ignoriert).
CLAUDE_API_KEY=
# Nicht für BärenwaldGPT nötig — Netlify setzt das ggf. automatisch auf /.netlify/ai/
# ANTHROPIC_API_KEY=
# Optional, Standard: claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6
# Diagnose nach Deploy: GET https://deine-domain.de/api/ki-rechner → configured + keyFormatOk
# Schutz: /api/ki-rechner — 30 Aufrufe/IP/Stunde (siehe guards.ts), Anthropic Spend-Limit empfohlen

# Bärenwald GPT Raumvisualisierung (Replicate + Storage)
REPLICATE_API_TOKEN=
GPT_VIZ_STORAGE_BUCKET=gpt-visualisierungen

# Portal-Auth: redirectTo für Bestätigung/Reset nutzt NEXT_PUBLIC_SITE_URL
# Lokal: http://localhost:3000 | Prod: https://baerenwaldmuenchen.de
# Supabase Auth → Custom SMTP (Resend) — siehe docs/SUPABASE_PORTAL_SETUP.md
