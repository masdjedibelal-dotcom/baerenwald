# NUR lokal: nach .env.local kopieren und Werte eintragen.
# Niemals TEST_AUTH_BYPASS / E2E_AUTO_SEED auf Netlify, Staging oder Prod setzen.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, siehe .env.example
LEAD_API_SECRET=

RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_CUSTOMER=
RESEND_FROM_SYSTEM=
INTERN_EMAIL=info@baerenwaldmuenchen.de

# --- NUR lokal (E2E / Dev) — auskommentiert lassen, außer auf dem Entwickler-Rechner ---
# TEST_AUTH_BYPASS=true
# E2E_AUTO_SEED=true setzt fehlende org_kennung auf baerenwald-hv (nur lokal)
# E2E_AUTO_SEED=true
# Optional: feste Test-Accounts (sonst OTP via Service-Role)
# E2E_ORG_EMAIL=
# E2E_ORG_PASSWORD=
# E2E_ORG_KENNUNG=
# E2E_OBJEKT_SLUG=
# E2E_CRM_BASE_URL=http://127.0.0.1:3001
# CRM_DEV_SKIP_AUTH=true (im CRM .env.local)
